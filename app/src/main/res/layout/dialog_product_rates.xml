<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Product Rates"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4F46E5"
            android:layout_marginBottom="16dp"/>

        <TextView 
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Product" 
            android:textSize="13sp"
            android:textStyle="bold" 
            android:textColor="#334155"
            android:layout_marginBottom="6dp"/>
        <Spinner
            android:id="@+id/spinnerRateProduct"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_rounded_edittext"
            android:popupBackground="@drawable/bg_spinner_popup"
            android:dropDownVerticalOffset="4dp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvBigRateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Big Product Rates"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Big Rate"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/box_stroke_selector"
            app:hintTextColor="@color/box_hint_selector"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBigRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvSmallRateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Small Product Rates"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Small Rate"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/box_stroke_selector"
            app:hintTextColor="@color/box_hint_selector"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSmallRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSaveRates"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save Rates"
            android:textStyle="bold"
            android:backgroundTint="#4F46E5"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>
