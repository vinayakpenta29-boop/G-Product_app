<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Premium Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#4F46E5"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="Product Manager"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HOME SECTION CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <LinearLayout
                    android:id="@+id/layoutHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Order Entry"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#4F46E5"
                        android:layout_marginBottom="12dp"/>

                    <TextView 
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Product" 
                        android:textSize="13sp"
                        android:textStyle="bold" 
                        android:textColor="#334155"
                        android:layout_marginBottom="6dp"/>
                    <Spinner
                        android:id="@+id/spinnerHomeProduct"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:id="@+id/layoutOrderInputs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnSaveOrder"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Save Order Box"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="#4F46E5"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="10dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SAVED UNPAID ORDERS CONTAINER -->
            <LinearLayout
                android:id="@+id/layoutSavedBoxes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
